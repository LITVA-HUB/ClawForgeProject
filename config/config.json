{
  "api": {
    "dmScope": "main"
  },
  "audit": {
    "enabled": true,
    "file": "./state/audit/events.jsonl"
  },
  "browser": {
    "backend": "stub",
    "enabled": true,
    "openCommand": "open",
    "openTimeoutMs": 15000
  },
  "cron": {
    "enabled": true,
    "tickMs": 1000
  },
  "gateway": {
    "auth": {
      "mode": "off",
      "tokenEnv": "NEXACLAW_GATEWAY_TOKEN"
    },
    "messageQueueTimeoutMs": 15000
  },
  "http": {
    "host": "127.0.0.1",
    "port": 18890
  },
  "model": {
    "apiKeyEnv": "OPENAI_API_KEY",
    "enabled": true,
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "maxTokens": 700,
    "model": "gpt-4o-mini",
    "systemPrompt": "Ты NexaClaw, личный AI-ассистент в стиле senior engineer: отвечай по делу, коротко и полезно.",
    "temperature": 0.2
  },
  "modelsConfig": {
    "models": {
      "anthropic/claude-3-5-haiku-latest": {
        "model": "claude-3-5-haiku-latest",
        "provider": "anthropic"
      },
      "gemini/gemini-1.5-flash": {
        "model": "gemini-1.5-flash",
        "provider": "gemini"
      },
      "minimax/abab6.5-chat": {
        "model": "abab6.5-chat",
        "provider": "minimax"
      },
      "openai/gpt-4o-mini": {
        "model": "gpt-4o-mini",
        "provider": "openai"
      },
      "openrouter/openai/gpt-4o-mini": {
        "model": "openai/gpt-4o-mini",
        "provider": "openrouter"
      }
    },
    "providers": {
      "anthropic": {
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "apiStyle": "anthropic_messages",
        "endpoint": "https://api.anthropic.com/v1/messages"
      },
      "gemini": {
        "apiKeyEnv": "GEMINI_API_KEY",
        "apiStyle": "gemini_generate_content",
        "endpoint": "https://generativelanguage.googleapis.com/v1beta/models"
      },
      "minimax": {
        "apiKeyEnv": "MINIMAX_API_KEY",
        "apiStyle": "openai_chat",
        "endpoint": "https://api.minimax.io/v1/text/chatcompletion_v2"
      },
      "openai": {
        "apiKeyEnv": "OPENAI_API_KEY",
        "apiStyle": "openai_chat",
        "endpoint": "https://api.openai.com/v1/chat/completions"
      },
      "openrouter": {
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "apiStyle": "openai_chat",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions"
      }
    },
    "routing": {
      "aliases": {
        "default": "openai/gpt-4o-mini",
        "fast": "openai/gpt-4o-mini"
      },
      "current": "openai/gpt-4o-mini",
      "fallbacks": [
        "anthropic/claude-3-5-haiku-latest"
      ],
      "image": "openai/gpt-image-1",
      "imageFallbacks": []
    }
  },
  "name": "nexaclaw",
  "rateLimit": {
    "enabled": true,
    "maxRequests": 120,
    "windowMs": 60000
  },
  "stateDir": "./state",
  "taskLane": {
    "defaultTimeoutMs": 30000,
    "enabled": true,
    "maxQueue": 256
  },
  "telegram": {
    "allowFrom": [],
    "botTokenEnv": "TELEGRAM_BOT_TOKEN",
    "dmPolicy": "open",
    "enabled": false,
    "pollIntervalMs": 1500
  },
  "toolsPolicy": {
    "allow": [],
    "deny": [],
    "scopes": {
      "channels": {
        "telegram": {
          "allow": [
            "read"
          ],
          "deny": [
            "exec",
            "write",
            "edit"
          ]
        }
      },
      "global": {
        "allow": [],
        "deny": []
      },
      "peers": {}
    }
  },
  "workspace": "./workspace"
}
