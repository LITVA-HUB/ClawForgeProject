{
  "name": "nexaclaw",
  "workspace": "./workspace",
  "stateDir": "./state",
  "logLevel": "info",
  "http": {
    "host": "127.0.0.1",
    "port": 18890,
    "readTimeoutMs": 5000,
    "writeTimeoutMs": 10000
  },
  "gateway": {
    "auth": {
      "mode": "off",
      "tokenEnv": "NEXACLAW_GATEWAY_TOKEN"
    },
    "messageQueueTimeoutMs": 15000
  },
  "model": {
    "enabled": true,
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-4o-mini",
    "apiKeyEnv": "OPENAI_API_KEY",
    "temperature": 0.2,
    "maxTokens": 700,
    "systemPrompt": "Ты NexaClaw, личный AI-ассистент в стиле senior engineer: отвечай по делу, коротко и полезно."
  },
  "modelsConfig": {
    "providers": {
      "openai": {"endpoint": "https://api.openai.com/v1/chat/completions", "apiKeyEnv": "OPENAI_API_KEY", "apiStyle": "openai_chat"},
      "anthropic": {"endpoint": "https://api.anthropic.com/v1/messages", "apiKeyEnv": "ANTHROPIC_API_KEY", "apiStyle": "anthropic_messages"},
      "openrouter": {"endpoint": "https://openrouter.ai/api/v1/chat/completions", "apiKeyEnv": "OPENROUTER_API_KEY", "apiStyle": "openai_chat"},
      "gemini": {"endpoint": "https://generativelanguage.googleapis.com/v1beta/models", "apiKeyEnv": "GEMINI_API_KEY", "apiStyle": "gemini_generate_content"},
      "minimax": {"endpoint": "https://api.minimax.io/v1/text/chatcompletion_v2", "apiKeyEnv": "MINIMAX_API_KEY", "apiStyle": "openai_chat"}
    },
    "models": {
      "openai/gpt-4o-mini": {"provider": "openai", "model": "gpt-4o-mini"},
      "anthropic/claude-3-5-haiku-latest": {"provider": "anthropic", "model": "claude-3-5-haiku-latest"},
      "openrouter/openai/gpt-4o-mini": {"provider": "openrouter", "model": "openai/gpt-4o-mini"},
      "gemini/gemini-1.5-flash": {"provider": "gemini", "model": "gemini-1.5-flash"},
      "minimax/abab6.5-chat": {"provider": "minimax", "model": "abab6.5-chat"}
    },
    "routing": {
      "current": "openai/gpt-4o-mini",
      "aliases": {"default": "openai/gpt-4o-mini", "fast": "openai/gpt-4o-mini"},
      "fallbacks": ["anthropic/claude-3-5-haiku-latest"],
      "image": "openai/gpt-image-1",
      "imageFallbacks": []
    }
  },
  "telegram": {
    "enabled": false,
    "botTokenEnv": "TELEGRAM_BOT_TOKEN",
    "pollIntervalMs": 1500,
    "allowFrom": [],
    "dmPolicy": "open"
  },
  "api": {
    "dmScope": "main"
  },
  "toolsPolicy": {
    "allow": [],
    "deny": [],
    "scopes": {
      "global": {
        "allow": [],
        "deny": []
      },
      "channels": {
        "telegram": {
          "deny": ["exec"]
        }
      },
      "peers": {
        "telegram:123456": {
          "allow": ["read", "write"]
        }
      }
    }
  },
  "browser": {
    "enabled": true,
    "backend": "stub",
    "profile": "openclaw",
    "cliBinary": "openclaw",
    "openCommand": "open",
    "openTimeoutMs": 15000
  },
  "taskLane": {
    "enabled": true,
    "maxQueue": 256,
    "defaultTimeoutMs": 30000
  },
  "rateLimit": {
    "enabled": true,
    "maxRequests": 120,
    "windowMs": 60000
  },
  "audit": {
    "enabled": true,
    "file": "./state/audit/events.jsonl"
  },
  "cron": {
    "enabled": true,
    "tickMs": 1000
  }
}
