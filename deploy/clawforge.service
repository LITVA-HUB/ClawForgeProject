[Unit]
Description=NexaClaw AI gateway (legacy clawforge alias)
Documentation=https://github.com/LITVA-HUB/ClawForgeProject
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nexaclaw
ExecStart=%h/nexaclaw/build/nexaclaw run --config %h/nexaclaw/config/config.json
EnvironmentFile=-%h/.config/nexaclaw/env

Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexaclaw

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
