<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clawforge.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/clawforge/build/clawforge</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/you/clawforge/config/config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/you/clawforge</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/you/clawforge/state/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/clawforge/state/logs/stderr.log</string>
</dict>
</plist>
