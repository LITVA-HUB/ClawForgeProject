[Unit]
Description=NexaClaw gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nexaclaw
ExecStart=%h/nexaclaw/build/nexaclaw run --config %h/nexaclaw/config/config.json
Restart=on-failure
RestartSec=2
Environment=OPENAI_API_KEY=
Environment=NEXACLAW_GATEWAY_TOKEN=

[Install]
WantedBy=multi-user.target
